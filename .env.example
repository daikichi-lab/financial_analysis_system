# 決算書の読み取り(OCR)に使用。未設定でも他の機能は動作します。
ANTHROPIC_API_KEY=sk-ant-...

# 読み取りの設定。既定は claude-sonnet-5 / medium。
# 決算書の読み取りは表からの転記作業なので、高い設定は基本的に不要です。
# 判読しにくい書類で精度が足りない場合だけ上げてください。
#   モデル: claude-sonnet-5 → claude-opus-5
#   effort: low → medium → high
# 実際にどこまで下げられるかは npm run ocr:compare -- <決算書> で測れます。
# OCR_MODEL=claude-sonnet-5
# OCR_EFFORT=medium

# 概算コスト表示に使う為替レート（省略時 150）
# USD_JPY=150

# 初回起動時にだけ使われる初期管理者。作成後の変更は管理画面から行ってください。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234

PORT=3000
# DB_PATH=./server/db.sqlite

# HTTPS で配信する場合は 1 にしてセッションCookieに Secure を付ける
# COOKIE_SECURE=1

# 読み取りエンジン。free=無料（ローカル処理・費用0）／ claude=有料（Claude API）
OCR_ENGINE=free

# 読み取り元のファイルを保存しない場合は 0
# OCR_KEEP_FILE=0

# オフライン環境で Tesseract の日本語データを同梱する場合
# TESSERACT_LANG_PATH=./tessdata
